{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocaband",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-09",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Cloudflare Workers Assets serves matching static files BEFORE
    // invoking the Worker by default — and with not_found_handling
    // set to "single-page-application", unmatched paths fall through
    // to /index.html with status 200, so the Worker never runs at all
    // unless a path is explicitly opted in here.
    //
    // Two distinct reasons paths appear in this list:
    //   1. SPA HTML routes (/, /student, /accessibility-statement) —
    //      the Worker rewrites <title>/<meta>/<html> for ?lang=he|ar|ru
    //      so Googlebot indexes localized snippets (see worker/index.ts
    //      localizeHtmlResponse). Static assets (JS/CSS/fonts/img)
    //      aren't listed, so they skip the worker pass and stay cheap.
    //   2. Backend-proxy routes (/api/*, /socket.io/*) — the Worker
    //      passthrough-proxies these to Fly.io. Without the glob here
    //      the asset handler's SPA fallback served /index.html for
    //      every API call and every WebSocket upgrade, so OCR /
    //      translate / AI / Live Challenge / Quick Play all silently
    //      broke after the 2026-04-25 Render→Fly migration moved
    //      socket.io off api.vocaband.com onto same-origin
    //      /socket.io/. The Worker code was correct; it just never ran.
    //   3. Hashed assets (/assets/*) — the Worker turns a MISSING chunk
    //      into a real 404 instead of the SPA index.html fallback. Without
    //      this, a missing /assets/*.js returned index.html (200 text/html)
    //      carrying the /assets/* `immutable` Cache-Control from
    //      public/_headers, and Cloudflare's edge cached that HTML under the
    //      .js URL for a YEAR — poisoning every user on that edge with
    //      "Failed to load module script (MIME text/html)", which hung the
    //      lazy-loaded views (the Aug-2026 Speed Round / Word Hunt Arena
    //      outage). Existing assets pass through untouched; see the
    //      /assets/ guard in worker/index.ts. Cost: the Worker now runs on
    //      asset requests too — a cheap ASSETS.fetch + content-type check.
    "run_worker_first": [
      "/",
      "/student",
      "/accessibility-statement",
      "/api/*",
      "/socket.io/*",
      "/assets/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Browser Rendering binding — powers POST /api/pdf (worker/index.ts
  // handlePdf), which renders worksheet HTML to a real PDF via headless
  // Chromium. Available on the Workers Paid plan. No secret needed; the
  // binding is ambient on the account.
  "browser": {
    "binding": "BROWSER"
  }
}
