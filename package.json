{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:vite": "vite",
    "dev:all": "dev.bat",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check:entry-closure": "node scripts/check-entry-closure.mjs",
    "clean": "rm -rf dist",
    "gen:privacy-html": "tsx scripts/generate-privacy-html.ts",
    "gen:parents-html": "tsx scripts/generate-parents-html.ts",
    "prebuild": "npm run clean && npm run gen:privacy-html && npm run gen:parents-html",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc --noEmit -p tsconfig.ci.json",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "npx playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:auth": "npx playwright test --config e2e/playwright.auth.config.ts",
    "audit": "npm audit",
    "gen:types": "npx supabase gen types typescript --project-id $SUPABASE_PROJECT_REF --schema public > src/core/supabase-types.generated.ts",
    "translate:ru": "tsx scripts/translate-vocabulary-to-russian.ts",
    "install:prod": "npm install --legacy-peer-deps",
    "deploy:preview": "npm run build && wrangler deploy --config dist/vocaband/wrangler.json --name vocaband-preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@floating-ui/react": "^0.27.20",
    "@google/genai": "^2.13.0",
    "@google/generative-ai": "^0.24.1",
    "@google/model-viewer": "^4.3.1",
    "@sentry/node": "^10.68.0",
    "@sentry/react": "^10.68.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/multer": "^2.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.4",
    "canvas-confetti": "^1.9.4",
    "client-zip": "^2.5.0",
    "csvtojson": "^2.0.14",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "howler": "^2.2.4",
    "html2canvas-pro": "^2.3.1",
    "html2pdf.js": "^0.14.0",
    "jose": "^6.2.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.27.0",
    "mammoth": "^1.12.0",
    "motion": "^12.42.2",
    "multer": "^2.2.0",
    "node-fetch": "^3.3.2",
    "pptxgenjs": "^4.0.1",
    "qrcode-generator": "^2.0.4",
    "qrcode.react": "^4.2.0",
    "rate-limit-redis": "^5.0.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "redis": "^6.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.185.1",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "serialize-javascript": "^7.0.4",
    "@xmldom/xmldom": "^0.8.13",
    "postcss": "^8.5.10",
    "ip-address": "^10.1.1",
    "fast-uri": "^3.1.2",
    "brace-expansion@5": "^5.0.6",
    "ws@8": "^8.21.0",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "esbuild": "^0.28.1",
    "dompurify": "^3.4.11",
    "undici": "^7.28.0",
